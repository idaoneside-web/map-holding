{
  "name": "map-holding",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/lib/access/access.test.ts\" \"src/lib/agent/conversations.test.ts\"",
    "test:worker": "node --test \"worker/test/worker.test.ts\"",
    "dev:agent": "node --env-file-if-exists=\"worker/local/local.env\" \"worker/local/server.ts\"",
    "test:local": "node --test \"worker/local/local.test.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prettier": "^3",
    "typescript": "^5"
  }
}
